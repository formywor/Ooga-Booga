<html><head><title>Share Browser</title>
<HTA:APPLICATION ID="ShareBrowser" APPLICATIONNAME="Share Browser" BORDER="thin" CAPTION="yes" MAXIMIZEBUTTON="no" MINIMIZEBUTTON="yes" SCROLL="no" SINGLEINSTANCE="yes" SYSMENU="yes"/>
<meta http-equiv="X-UA-Compatible" content="IE=11">
<style>
html,body{margin:0;width:100%;height:100%;overflow:hidden;font:15px "Segoe UI",Arial;color:#fff}body{background:#090c14}body.vibrant{background:radial-gradient(circle at 15% 5%,#3b2f8b,transparent 40%),radial-gradient(circle at 90% 5%,#117465,transparent 35%),#090c14}.shell{width:740px;margin:auto;padding:26px}.eyebrow{color:#aeb7d0;letter-spacing:3px;font-weight:800;font-size:12px}h1{font-size:44px;margin:5px 0}.muted{color:#aab2c7}.panel{margin-top:16px;padding:20px;border:1px solid #343c51;border-radius:18px;background:rgba(18,23,36,.96);box-shadow:0 20px 50px rgba(0,0,0,.22)}.row{display:flex;gap:14px}.field{flex:1}label{display:block;color:#aab2c7;margin:11px 0 6px}input,select{width:100%;padding:11px;box-sizing:border-box;border:1px solid #3b4359;border-radius:10px;background:#0d111c;color:#fff;font-size:15px}input:focus,select:focus{outline:1px solid #7d68ff;border-color:#7d68ff}button{margin-top:14px;padding:12px 18px;border:0;border-radius:11px;background:linear-gradient(135deg,#735cff,#23ceb9);color:#fff;font-weight:800;cursor:pointer;box-shadow:0 8px 24px rgba(70,78,220,.24)}.secondary{background:#293047;box-shadow:none}.danger{background:#e24f69;box-shadow:none}#active{display:none}#clock{font-size:42px;font-weight:900}#status{white-space:pre-wrap;color:#aab2c7;margin-top:13px}.connected-overlay{display:none;position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(5,8,15,.76)}.connected-card{position:absolute;width:390px;left:50%;top:50%;margin-left:-195px;margin-top:-120px;padding:32px 24px;border:1px solid #4f5a78;border-radius:20px;background:#121724;text-align:center;box-shadow:0 30px 90px rgba(0,0,0,.5)}.connected-icon{width:62px;height:62px;margin:0 auto 14px;border-radius:50%;background:#23ceb9;color:#07140f;font-size:38px;line-height:62px;font-weight:900}.connected-title{font-size:32px;font-weight:900}.connected-copy{margin-top:7px;color:#aab2c7}.confetti{position:absolute;width:8px;height:15px;border-radius:2px;animation:confetti-fall 1.8s ease-out forwards}@keyframes confetti-fall{0%{opacity:1;transform:translateY(-30px) rotate(0deg)}100%{opacity:0;transform:translateY(280px) rotate(540deg)}}
</style><script language="javascript">
"use strict";
var API_BASE="https://api.scriptnovaa.com/api";
var state={login:"",proof:"",registered:false,id:"",secret:"",expires:0,profile:"",heartbeat:null,countdown:null,processCheck:null,ending:false};
function $(id){return document.getElementById(id)}
function trim(v){return String(v||"").replace(/^\s+|\s+$/g,"")}
function status(text,bad){$("status").innerText=text;$("status").style.color=bad?"#ff7088":"#aab2c7"}
function psQuote(v){return String(v).replace(/'/g,"''")}
function output(command){var shell=new ActiveXObject("WScript.Shell");var p=shell.Exec(command);return trim(p.StdOut.ReadAll())}
function run(command,wait){return new ActiveXObject("WScript.Shell").Run(command,0,Boolean(wait))}
function api(path,body,login){
  var r=new ActiveXObject("WinHttp.WinHttpRequest.5.1");
  r.Open("POST",API_BASE+path,false);r.SetTimeouts(5000,5000,5000,8000);
  r.SetRequestHeader("Content-Type","application/json");
  if(login)r.SetRequestHeader("Authorization","Bearer "+login);
  r.Send(JSON.stringify(body||{}));var data;
  try{data=JSON.parse(r.ResponseText)}catch(e){throw new Error("Invalid API response.")}
  if(r.Status<200||r.Status>=300||data.ok===false)throw new Error(data.error||data.reason||"API request failed.");
  return data;
}
function deviceProof(){
  var command="powershell.exe -NoProfile -Command \""+
    "$u=(Get-CimInstance Win32_ComputerSystemProduct).UUID;"+
    "$b=(Get-CimInstance Win32_BIOS).SerialNumber;"+
    "$m=(Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Cryptography').MachineGuid;"+
    "Write-Output ($u+'|'+$b+'|'+$m+'|'+$env:COMPUTERNAME)\"";
  return output(command);
}
function exists(path){return new ActiveXObject("Scripting.FileSystemObject").FileExists(path)}
function browserPath(kind){
  var shell=new ActiveXObject("WScript.Shell"),p=[];
  if(kind==="chrome")p=[shell.ExpandEnvironmentStrings("%ProgramFiles%")+"\\Google\\Chrome\\Application\\chrome.exe",shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%")+"\\Google\\Chrome\\Application\\chrome.exe",shell.ExpandEnvironmentStrings("%LocalAppData%")+"\\Google\\Chrome\\Application\\chrome.exe"];
  else p=[shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%")+"\\Microsoft\\Edge\\Application\\msedge.exe",shell.ExpandEnvironmentStrings("%ProgramFiles%")+"\\Microsoft\\Edge\\Application\\msedge.exe"];
  for(var i=0;i<p.length;i++)if(exists(p[i]))return p[i];
  throw new Error(kind==="chrome"?"Google Chrome was not found.":"Microsoft Edge was not found.");
}
function matchingProcesses(){
  if(!state.profile)return 0;
  var command="powershell.exe -NoProfile -Command \""+
    "$p='"+psQuote(state.profile)+"';"+
    "@(Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like ('*'+$p+'*') }).Count\"";
  return parseInt(output(command),10)||0;
}
function killSessionBrowser(){
  if(!state.profile)return;
  var command="powershell.exe -NoProfile -WindowStyle Hidden -Command \""+
    "$p='"+psQuote(state.profile)+"';"+
    "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like ('*'+$p+'*') } | "+
    "ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }\"";
  try{run(command,true)}catch(e){}
}
function showConnected(){
  var overlay=$("connected-overlay");
  var colors=["#735cff","#23ceb9","#ffd166","#ff6685","#ffffff"];
  overlay.style.display="block";
  for(var i=0;i<36;i++){
    var piece=document.createElement("span");
    piece.className="confetti";
    piece.style.left=(5+Math.random()*90)+"%";
    piece.style.top=(-20-Math.random()*80)+"px";
    piece.style.backgroundColor=colors[i%colors.length];
    piece.style.animationDelay=(Math.random()*.45)+"s";
    overlay.appendChild(piece);
  }
  setTimeout(function(){overlay.style.display="none";
    var pieces=overlay.getElementsByTagName("span");
    while(pieces.length)overlay.removeChild(pieces[0]);
  },2300);
}
function connectAccount(showAnimation){
  state.login=trim($("login").value);
  if(!state.login)throw new Error("Paste the launcher connection token from the Tokens page.");
  status("Connecting to ScriptNovaa...",false);
  state.proof=deviceProof();
  if(state.proof.length<20)throw new Error("Windows could not create a computer identity. Run Share Browser normally, not from a restricted folder.");
  var result=api("/api/device/register",{deviceProof:state.proof},state.login);
  if(result.riskStatus==="REVIEW")throw new Error("This computer connected, but the account is being held for risk review.");
  state.registered=true;
  status(result.alreadyRegistered?"Connected to your registered computer.":"Computer registered and connected.",false);
  if(showAnimation)showConnected();
  return result;
}
function registerDevice(){
  try{connectAccount(true)}catch(e){state.registered=false;status("Connection failed: "+e.message,true)}
}
function launch(executable,args){
  var command="powershell.exe -NoProfile -WindowStyle Hidden -Command \""+
    "Start-Process -FilePath '"+psQuote(executable)+"' -ArgumentList '"+psQuote(args)+"'\"";
  run(command,true);
}
function start(){
  try{
    state.login=trim($("login").value);if(!state.login)throw new Error("Paste the launcher connection token from the Tokens page.");
    if(!state.registered)connectAccount(false);
    var browserToken=trim($("browser-token").value);if(!browserToken)throw new Error("Paste a browser token.");
    var kind=$("browser").value,exe=browserPath(kind);
    var activation=api("/api/session/activate",{token:browserToken,browser:kind,presetId:$("preset").value,deviceProof:state.proof},state.login);
    state.id=activation.sessionId;state.secret=activation.sessionSecret;state.expires=new Date(activation.expiresAt).getTime();
    state.profile=new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%LOCALAPPDATA%")+"\\ScriptNovaa\\ShareBrowser\\Profiles\\"+state.id;
    var args='--user-data-dir="'+state.profile+'" --new-window '+activation.launch.flags.join(" ")+" https://scriptnovaa.com/";
    launch(exe,args);$("setup").style.display="none";$("active").style.display="block";
    state.heartbeat=setInterval(heartbeat,activation.heartbeatSeconds*1000);
    state.countdown=setInterval(tick,1000);state.processCheck=setInterval(checkProcess,2500);
    tick();status("Session active. Closing the browser or launcher permanently ends this token.",false);
  }catch(e){if(state.id)end("LAUNCH_FAILED");status(e.message,true)}
}
function heartbeat(){if(state.ending||!state.id)return;try{api("/api/session/heartbeat",{sessionId:state.id,sessionSecret:state.secret},"")}catch(e){end("HEARTBEAT_FAILED");status("Validation failed. The browser was closed and the token ended.",true)}}
function checkProcess(){if(!state.ending&&state.id&&matchingProcesses()===0){end("BROWSER_CLOSED");status("The browser closed. The token is finished.",false)}}
function tick(){var left=Math.max(0,state.expires-new Date().getTime()),s=Math.floor(left/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60);s=s%60;$("clock").innerText=(h<10?"0":"")+h+":"+(m<10?"0":"")+m+":"+(s<10?"0":"")+s;if(left<=0){end("TIME_EXPIRED");status("Time expired. The browser was closed.",false)}}
function end(reason){
  if(state.ending)return;state.ending=true;
  clearInterval(state.heartbeat);clearInterval(state.countdown);clearInterval(state.processCheck);killSessionBrowser();
  if(state.id&&state.secret)try{api("/api/session/end",{sessionId:state.id,sessionSecret:state.secret,reason:reason},"")}catch(e){}
  state.id="";state.secret="";state.expires=0;state.profile="";$("active").style.display="none";$("setup").style.display="block";state.ending=false;
}
function init(){window.resizeTo(830,710);$("register").onclick=registerDevice;$("start").onclick=start;$("end").onclick=function(){end("USER_ENDED");status("Session ended. The token cannot be reused.",false)};$("theme").onchange=function(){document.body.className=this.value}}
window.onbeforeunload=function(){if(state.id){killSessionBrowser();try{api("/api/session/end",{sessionId:state.id,sessionSecret:state.secret,reason:"LAUNCHER_CLOSED"},"")}catch(e){}}};
</script></head>
<body class="vibrant" onload="init()"><div class="shell"><div class="eyebrow">SCRIPTNOVAA PRESENTS</div><h1>Share Browser</h1><div class="muted">Paste a token, choose your settings, and start a timed browser session.</div>
<div id="setup" class="panel"><label>Launcher connection token</label><input id="login" type="password" placeholder="Paste the connection token from your Tokens page"><button id="register" class="secondary">Connect this computer</button><label>Share Browser token</label><input id="browser-token" placeholder="SHARE-XXXX-XXXX-XXXX">
<div class="row"><div class="field"><label>Browser</label><select id="browser"><option value="chrome">Google Chrome</option><option value="edge">Microsoft Edge</option></select></div><div class="field"><label>Appearance</label><select id="theme"><option value="vibrant">Vibrant</option><option value="">Minimal</option></select></div></div>
<label>Browser preset</label><select id="preset"><option value="balanced">Balanced</option><option value="privacy">Privacy</option><option value="minimal">Minimal</option></select><button id="start">Start Browser</button><p class="muted">Continuous internet is required. Closing Chrome/Edge, closing this launcher, validation failure, or timeout permanently finishes the token.</p></div>
<div id="active" class="panel"><div class="muted">TIME REMAINING</div><div id="clock">00:00:00</div><button id="end" class="danger">End session</button></div><div id="status"></div></div>
<div id="connected-overlay" class="connected-overlay"><div class="connected-card"><div class="connected-icon">&#10003;</div><div class="connected-title">Connected!</div><div class="connected-copy">Share Browser is connected to your ScriptNovaa account.</div></div></div>
</body></html>

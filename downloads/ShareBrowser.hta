<html><head><title>Share Browser</title>
<HTA:APPLICATION ID="ShareBrowser" APPLICATIONNAME="Share Browser" BORDER="thin" CAPTION="yes" MAXIMIZEBUTTON="no" MINIMIZEBUTTON="yes" SCROLL="no" SINGLEINSTANCE="yes" SYSMENU="yes"/>
<meta http-equiv="X-UA-Compatible" content="IE=11">
<style>
html,body{margin:0;width:100%;height:100%;overflow:hidden;font:15px "Segoe UI",Arial;color:#fff}body{background:#090c14}body.vibrant{background:radial-gradient(circle at 15% 5%,#3b2f8b,transparent 40%),radial-gradient(circle at 90% 5%,#117465,transparent 35%),#090c14}.shell{width:740px;margin:auto;padding:26px}.eyebrow{color:#aeb7d0;letter-spacing:3px;font-weight:800;font-size:12px}h1{font-size:44px;margin:5px 0}.muted{color:#aab2c7}.panel{margin-top:16px;padding:20px;border:1px solid #343c51;border-radius:18px;background:rgba(18,23,36,.96);box-shadow:0 20px 50px rgba(0,0,0,.22)}.row{display:flex;gap:14px}.field{flex:1}label{display:block;color:#aab2c7;margin:11px 0 6px}input,select{width:100%;padding:11px;box-sizing:border-box;border:1px solid #3b4359;border-radius:10px;background:#0d111c;color:#fff;font-size:15px}input:focus,select:focus{outline:1px solid #7d68ff;border-color:#7d68ff}button{margin-top:14px;padding:12px 18px;border:0;border-radius:11px;background:linear-gradient(135deg,#735cff,#23ceb9);color:#fff;font-weight:800;cursor:pointer;box-shadow:0 8px 24px rgba(70,78,220,.24)}button:disabled{opacity:.55;cursor:wait}.secondary{background:#293047;box-shadow:none}.danger{background:#e24f69;box-shadow:none}.browser-warning{margin:14px 0 0;padding:11px 13px;border:1px solid #755c2e;border-radius:10px;background:#251e10;color:#f5d88b;font-size:13px;line-height:1.45}#active{display:none}#clock{font-size:42px;font-weight:900}#status{display:none;white-space:pre-wrap;margin-top:13px;padding:12px 14px;border:1px solid #3e4963;border-radius:10px;background:#121927;color:#b8c2da}#status.status-error{display:block;border-color:#8f3c50;background:#28141c;color:#ff91a4}#status.status-ok{display:block;border-color:#276a5f;background:#10231f;color:#8fe7d1}.connected-overlay{display:none;position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(5,8,15,.76)}.connected-card{position:absolute;width:390px;left:50%;top:50%;margin-left:-195px;margin-top:-120px;padding:32px 24px;border:1px solid #4f5a78;border-radius:20px;background:#121724;text-align:center;box-shadow:0 30px 90px rgba(0,0,0,.5)}.connected-icon{width:62px;height:62px;margin:0 auto 14px;border-radius:50%;background:#23ceb9;color:#07140f;font-size:38px;line-height:62px;font-weight:900}.connected-title{font-size:32px;font-weight:900}.connected-copy{margin-top:7px;color:#aab2c7}.confetti{position:absolute;width:8px;height:15px;border-radius:2px;animation:confetti-fall 1.8s ease-out forwards}@keyframes confetti-fall{0%{opacity:1;transform:translateY(-30px) rotate(0deg)}100%{opacity:0;transform:translateY(280px) rotate(540deg)}}
</style><script language="javascript">
"use strict";
var API_BASE="https://api.scriptnovaa.com";
var REGISTRY_BASE="HKCU\\Software\\ScriptNovaa\\ShareBrowser\\";
var state={login:"",proof:"",registered:false,id:"",secret:"",expires:0,profile:"",browserProcessName:"",heartbeat:null,countdown:null,processCheck:null,ending:false};
function $(id){return document.getElementById(id)}
function trim(v){return String(v||"").replace(/^\s+|\s+$/g,"")}
function status(text,bad){$("status").innerText=text;$("status").className=bad?"status-error":"status-ok"}
function wmi(){return GetObject("winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2")}
function firstWmiValue(query,propertyName){
  try{
    var items=new Enumerator(wmi().ExecQuery(query));
    if(items.atEnd())return "";
    var value=items.item().Properties_.Item(propertyName).Value;
    return trim(value);
  }catch(e){return ""}
}
function api(path,body,login){
  var r=new ActiveXObject("WinHttp.WinHttpRequest.5.1");
  r.Open("POST",API_BASE+path,false);r.SetTimeouts(5000,5000,5000,8000);
  r.SetRequestHeader("Content-Type","application/json");
  if(login)r.SetRequestHeader("Authorization","Bearer "+login);
  r.Send(JSON.stringify(body||{}));var data;
  try{data=JSON.parse(r.ResponseText)}catch(e){throw new Error("Invalid API response.")}
  if(r.Status<200||r.Status>=300||data.ok===false){
    var apiError=new Error("API "+r.Status+": "+(data.error||data.reason||"Request failed."));
    apiError.apiStatus=r.Status;
    throw apiError;
  }
  return data;
}
function registryRead(name){
  try{return String(new ActiveXObject("WScript.Shell").RegRead(REGISTRY_BASE+name)||"")}catch(e){return ""}
}
function registryWrite(name,value){
  new ActiveXObject("WScript.Shell").RegWrite(REGISTRY_BASE+name,String(value),"REG_SZ");
}
function clearSavedConnection(){
  var shell=new ActiveXObject("WScript.Shell");
  try{shell.RegDelete(REGISTRY_BASE+"LauncherToken")}catch(e){}
  try{shell.RegDelete(REGISTRY_BASE+"DeviceProof")}catch(e2){}
}
function saveConnection(){
  registryWrite("LauncherToken",state.login);
  registryWrite("DeviceProof",state.proof);
}
function setConnectionUi(connected){
  $("pairing-code").disabled=connected;
  $("register").disabled=connected;
  if(connected){
    $("pairing-code").value="Connected to ScriptNovaa";
    $("register").innerText="Computer connected";
  }else{
    $("pairing-code").value="";
    $("pairing-code").placeholder="XXXXX-XXXXX";
    $("register").innerText="Connect this computer";
  }
}
function psSingle(v){return String(v).replace(/'/g,"''")}
function deviceProof(){
  var shell=new ActiveXObject("WScript.Shell");
  var fileSystem=new ActiveXObject("Scripting.FileSystemObject");
  var temporaryFile=shell.ExpandEnvironmentStrings("%TEMP%")+"\\ShareBrowser-device-"+new Date().getTime()+"-"+Math.floor(Math.random()*100000)+".txt";
  try{
    var script="$u=(Get-CimInstance Win32_ComputerSystemProduct).UUID;"+
      "$b=(Get-CimInstance Win32_BIOS).SerialNumber;"+
      "$m=(Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Cryptography').MachineGuid;"+
      "[System.IO.File]::WriteAllText('"+psSingle(temporaryFile)+"',[string]($u+'|'+$b+'|'+$m+'|'+$env:COMPUTERNAME))";
    var command="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command \""+script+"\"";
    shell.Run(command,0,true);
    if(fileSystem.FileExists(temporaryFile)){
      var textFile=fileSystem.OpenTextFile(temporaryFile,1,false);
      var proof=trim(textFile.ReadAll());
      textFile.Close();
      fileSystem.DeleteFile(temporaryFile,true);
      if(proof.length>=20)return proof;
    }
  }catch(powerShellError){
    try{if(fileSystem.FileExists(temporaryFile))fileSystem.DeleteFile(temporaryFile,true)}catch(cleanupError){}
  }
  var uuid=firstWmiValue("Select UUID From Win32_ComputerSystemProduct","UUID");
  var bios=firstWmiValue("Select SerialNumber From Win32_BIOS","SerialNumber");
  var machineGuid="";
  try{machineGuid=new ActiveXObject("WScript.Shell").RegRead("HKLM\\SOFTWARE\\Microsoft\\Cryptography\\MachineGuid")}catch(e){}
  var computerName="";
  try{computerName=new ActiveXObject("WScript.Network").ComputerName}catch(e2){}
  return [uuid,bios,machineGuid,computerName].join("|");
}
function restoreConnection(){
  var savedLogin=registryRead("LauncherToken");
  var savedProof=registryRead("DeviceProof");
  if(!savedLogin||savedProof.length<20){
    setConnectionUi(false);
    return false;
  }
  state.login=savedLogin;
  state.proof=savedProof;
  state.registered=true;
  setConnectionUi(true);
  try{
    var result=api("/api/device/launcher/status",{deviceProof:state.proof},state.login);
    status("Connected to "+result.username+". Your saved computer connection is ready.",false);
  }catch(e){
    if(e.apiStatus===401||e.apiStatus===403){
      clearSavedConnection();
      state.login="";state.proof="";state.registered=false;
      setConnectionUi(false);
      status("Your saved connection is no longer valid. Request a replacement code from ScriptNovaa Support.",true);
      return false;
    }
    status("Your saved connection is available, but ScriptNovaa could not verify it right now.",true);
  }
  return true;
}
function exists(path){return new ActiveXObject("Scripting.FileSystemObject").FileExists(path)}
function browserPath(kind){
  var shell=new ActiveXObject("WScript.Shell"),p=[];
  if(kind==="chrome")p=[shell.ExpandEnvironmentStrings("%ProgramFiles%")+"\\Google\\Chrome\\Application\\chrome.exe",shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%")+"\\Google\\Chrome\\Application\\chrome.exe",shell.ExpandEnvironmentStrings("%LocalAppData%")+"\\Google\\Chrome\\Application\\chrome.exe"];
  else p=[shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%")+"\\Microsoft\\Edge\\Application\\msedge.exe",shell.ExpandEnvironmentStrings("%ProgramFiles%")+"\\Microsoft\\Edge\\Application\\msedge.exe"];
  for(var i=0;i<p.length;i++)if(exists(p[i]))return p[i];
  throw new Error(kind==="chrome"?"Google Chrome was not found.":"Microsoft Edge was not found.");
}
function browserProcessCount(){
  if(!state.browserProcessName)return 0;
  var count=0;
  try{
    var items=new Enumerator(wmi().ExecQuery("Select ProcessId From Win32_Process Where Name='"+state.browserProcessName+"'"));
    for(;!items.atEnd();items.moveNext())count++;
  }catch(e){}
  return count;
}
function killAllSelectedBrowserProcesses(){
  if(!state.browserProcessName)return;
  for(var attempt=0;attempt<3;attempt++){
    try{
      var items=new Enumerator(wmi().ExecQuery("Select * From Win32_Process Where Name='"+state.browserProcessName+"'"));
      for(;!items.atEnd();items.moveNext()){
        try{items.item().Terminate()}catch(e){}
      }
    }catch(e2){}
    if(browserProcessCount()===0)return;
  }
}
function removeSessionProfile(profilePath){
  if(!profilePath)return;
  try{
    var shell=new ActiveXObject("WScript.Shell");
    var base=shell.ExpandEnvironmentStrings("%LOCALAPPDATA%")+"\\ScriptNovaa\\ShareBrowser\\Profiles\\";
    if(String(profilePath).toLowerCase().indexOf(base.toLowerCase())!==0)return;
    var fileSystem=new ActiveXObject("Scripting.FileSystemObject");
    if(fileSystem.FolderExists(profilePath))fileSystem.DeleteFolder(profilePath,true);
  }catch(e){}
}
function showConnected(){
  var overlay=$("connected-overlay");
  var colors=["#735cff","#23ceb9","#ffd166","#ff6685","#ffffff"];
  overlay.style.display="block";
  for(var i=0;i<36;i++){
    var piece=document.createElement("span");
    piece.className="confetti";
    piece.style.left=(5+Math.random()*90)+"%";
    piece.style.top=(-20-Math.random()*80)+"px";
    piece.style.backgroundColor=colors[i%colors.length];
    piece.style.animationDelay=(Math.random()*.45)+"s";
    overlay.appendChild(piece);
  }
  setTimeout(function(){overlay.style.display="none";
    var pieces=overlay.getElementsByTagName("span");
    while(pieces.length)overlay.removeChild(pieces[0]);
  },2300);
}
function connectAccount(showAnimation){
  var pairingCode=trim($("pairing-code").value);
  if(!pairingCode)throw new Error("Generate a connection code on the Tokens page, then enter it here.");
  status("Connecting to ScriptNovaa...",false);
  state.proof=deviceProof();
  if(state.proof.length<20)throw new Error("Windows could not create a computer identity. Run Share Browser normally, not from a restricted folder.");
  var result=api("/api/device/pairing/complete",{pairingCode:pairingCode,deviceProof:state.proof},"");
  if(result.riskStatus==="REVIEW")throw new Error("This computer connected, but the account is being held for risk review.");
  state.login=result.launcherToken;
  if(!state.login)throw new Error("The API did not return a launcher session.");
  state.registered=true;
  saveConnection();
  setConnectionUi(true);
  status(result.alreadyRegistered?"Connected to your registered computer.":"Computer registered and connected.",false);
  if(showAnimation)showConnected();
  return result;
}
function registerDevice(){
  try{connectAccount(true)}catch(e){state.registered=false;status("Connection failed: "+e.message,true)}
}
function launch(executable,args){
  try{
    new ActiveXObject("Shell.Application").ShellExecute(executable,args,"","open",1);
  }catch(e){
    throw new Error("Windows could not start the selected browser.");
  }
}
function start(){
  var startButton=$("start");
  try{
    startButton.disabled=true;startButton.innerText="Starting...";
    if(!state.registered)connectAccount(false);
    var browserToken=trim($("browser-token").value);if(!browserToken)throw new Error("Paste a browser token.");
    var kind=$("browser").value,exe=browserPath(kind);
    status("Validating the token and preparing "+(kind==="chrome"?"Google Chrome":"Microsoft Edge")+"...",false);
    var activation=api("/api/session/activate",{token:browserToken,browser:kind,presetId:$("preset").value,userAgentId:$("user-agent").value,deviceProof:state.proof},state.login);
    state.id=activation.sessionId;state.secret=activation.sessionSecret;state.expires=new Date(activation.expiresAt).getTime();
    state.profile=new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%LOCALAPPDATA%")+"\\ScriptNovaa\\ShareBrowser\\Profiles\\"+state.id;
    state.browserProcessName=kind==="chrome"?"chrome.exe":"msedge.exe";
    var args='--user-data-dir="'+state.profile+'" --new-window '+activation.launch.flags.join(" ");
    if(activation.launch.userAgent)args+=' --user-agent="'+String(activation.launch.userAgent).replace(/"/g,"")+'"';
    args+=" https://scriptnovaa.com/";
    status("Closing every open "+(kind==="chrome"?"Google Chrome":"Microsoft Edge")+" window before launch...",false);
    killAllSelectedBrowserProcesses();
    if(browserProcessCount()!==0)throw new Error("Some browser processes could not be closed. Save your work, close the browser, and try again.");
    launch(exe,args);$("setup").style.display="none";$("active").style.display="block";
    state.heartbeat=setInterval(heartbeat,activation.heartbeatSeconds*1000);
    state.countdown=setInterval(tick,1000);state.processCheck=setInterval(checkProcess,2500);
    tick();status("Session active. Closing the browser or launcher permanently ends this token.",false);
  }catch(e){if(state.id)end("LAUNCH_FAILED");status("Start failed: "+e.message,true)}
  finally{startButton.disabled=false;startButton.innerText="Start Browser"}
}
function heartbeat(){if(state.ending||!state.id)return;try{api("/api/session/heartbeat",{sessionId:state.id,sessionSecret:state.secret},"")}catch(e){end("HEARTBEAT_FAILED");status("Validation failed. The browser was closed and the token ended.",true)}}
function checkProcess(){if(!state.ending&&state.id&&browserProcessCount()===0){end("BROWSER_CLOSED");status("The browser closed. The token is finished.",false)}}
function tick(){var left=Math.max(0,state.expires-new Date().getTime()),s=Math.floor(left/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60);s=s%60;$("clock").innerText=(h<10?"0":"")+h+":"+(m<10?"0":"")+m+":"+(s<10?"0":"")+s;if(left<=0){end("TIME_EXPIRED");status("Time expired. The browser was closed.",false)}}
function end(reason){
  if(state.ending)return;state.ending=true;
  clearInterval(state.heartbeat);clearInterval(state.countdown);clearInterval(state.processCheck);
  var finishedProfile=state.profile;
  killAllSelectedBrowserProcesses();removeSessionProfile(finishedProfile);
  if(state.id&&state.secret)try{api("/api/session/end",{sessionId:state.id,sessionSecret:state.secret,reason:reason},"")}catch(e){}
  state.id="";state.secret="";state.expires=0;state.profile="";state.browserProcessName="";$("active").style.display="none";$("setup").style.display="block";state.ending=false;
}
function init(){window.resizeTo(830,800);$("register").onclick=registerDevice;$("start").onclick=start;$("end").onclick=function(){end("USER_ENDED");status("Session ended. The token cannot be reused.",false)};$("theme").onchange=function(){document.body.className=this.value};restoreConnection()}
window.onbeforeunload=function(){if(state.id){var finishedProfile=state.profile;killAllSelectedBrowserProcesses();removeSessionProfile(finishedProfile);try{api("/api/session/end",{sessionId:state.id,sessionSecret:state.secret,reason:"LAUNCHER_CLOSED"},"")}catch(e){}}};
</script></head>
<body class="vibrant" onload="init()"><div class="shell"><div class="eyebrow">SCRIPTNOVAA PRESENTS</div><h1>Share Browser</h1><div class="muted">Paste a token, choose your settings, and start a timed browser session.</div>
<div id="setup" class="panel"><label>One-time connection code</label><input id="pairing-code" placeholder="XXXXX-XXXXX"><button id="register" class="secondary">Connect this computer</button><p class="muted">Once connected, this launcher remembers the computer. Replacement codes must be requested at scriptnovaa.com/support.</p><label>Share Browser token</label><input id="browser-token" placeholder="SHARE-XXXX-XXXX-XXXX">
<div class="row"><div class="field"><label>Browser</label><select id="browser"><option value="chrome">Google Chrome</option><option value="edge">Microsoft Edge</option></select></div><div class="field"><label>Appearance</label><select id="theme"><option value="vibrant">Vibrant</option><option value="">Minimal</option></select></div></div>
<div class="row"><div class="field"><label>Browser preset</label><select id="preset"><option value="balanced">Balanced</option><option value="privacy">Privacy</option><option value="minimal">Minimal</option></select></div><div class="field"><label>User agent</label><select id="user-agent"><option value="default">Browser default</option><option value="shareDesktop">Share Browser Desktop</option></select></div></div><div class="browser-warning"><strong>Save your browser work first.</strong> Starting a session closes every open window of the selected browser so the Share Browser flags apply. Ending the session closes that browser completely and removes the temporary Share Browser profile.</div><button id="start">Start Browser</button><p class="muted">Continuous internet is required. Closing Chrome/Edge, closing this launcher, validation failure, or timeout permanently finishes the token.</p><div id="status"></div></div>
<div id="active" class="panel"><div class="muted">TIME REMAINING</div><div id="clock">00:00:00</div><button id="end" class="danger">End session</button></div></div>
<div id="connected-overlay" class="connected-overlay"><div class="connected-card"><div class="connected-icon">&#10003;</div><div class="connected-title">Connected!</div><div class="connected-copy">Share Browser is connected to your ScriptNovaa account.</div></div></div>
</body></html>
